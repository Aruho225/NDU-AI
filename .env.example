# --- LiveKit (realtime voice + Twilio Media Streams) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=ndu-assistant
# Country hint for LiveKit Twilio connector (US, UG, etc.)
LIVEKIT_DESTINATION_COUNTRY=US
LIVEKIT_TELEPHONY_NC=1

# Speech / LLM for LiveKit agent
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02

# Voice pipeline: livekit (realtime Deepgram STT) | twiml (Twilio Gather + Polly fallback)
VOICE_MODE=livekit

# --- Web UI login ---
APP_LOGIN_USER=student
APP_LOGIN_PASSWORD=changeme
APP_LOGIN_EMAIL=
# Keep users signed in across browser reloads (days, max 90)
APP_SESSION_DAYS=30

# --- Twilio (phone + SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public HTTPS URL for FastAPI (ngrok/cloudflare tunnel to port 8000)
TWILIO_WEBHOOK_BASE_URL=
